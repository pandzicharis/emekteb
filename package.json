{
  "name": "emekteb",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared-types",
    "packages/shared-utils"
  ],
  "scripts": {
    "dev:api": "cd apps/api && nest start --watch --webpack",
    "dev:web": "cd apps/web && vite",
    "build:api": "cd apps/api && nest build",
    "build:web": "cd apps/web && tsc -p tsconfig.app.json --noEmit && vite build",
    "start:api": "cd apps/api && prisma migrate deploy && node dist/main.js",
    "db:generate": "cd apps/api && prisma generate",
    "db:migrate": "cd apps/api && prisma migrate dev",
    "db:deploy": "cd apps/api && prisma migrate deploy",
    "db:studio": "cd apps/api && prisma studio"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "csv-parse": "^6.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6"
  }
}
