// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    // url      = "postgresql://postgres:postgres@localhost:5439/emekteb?schema=public"
    url      = env("DATABASE_URL")
}

// ============================================
// KORISNICI I AUTENTIFIKACIJA
// ============================================

model Korisnik {
    id                 String    @id @default(uuid())
    email              String?   @unique
    lozinka            String // Hashed password
    ime                String?
    prezime            String?
    uloga              Uloga     @default(UCENIK)
    aktivan            Boolean   @default(true)
    fotografija        String? // URL ili path do fotografije
    pin                String?   @unique // PIN za brzi login (4-6 cifara)
    poslednjeLogiranje DateTime? // Vreme poslednjeg logiranja
    kreiran            DateTime  @default(now())
    azuriran           DateTime  @updatedAt

    // Relacije
    ucenik Ucenik?

    @@map("korisnici")
}

enum Uloga {
    UCENIK
    MUALLIM
    ADMIN
}

// ============================================
// UČENICI - OSNOVNE TABELE
// ============================================

model Ucenik {
    id         String  @id @default(uuid())
    korisnikId String? @unique
    eksterniId Int?    @unique // ID iz eksternog sistema

    // Osnovni podaci
    datumRodjenja    DateTime?
    spol             Spol?
    mjestoRodjenja   String?
    adresaStanovanja String?

    // Status
    status                StatusUcenika?
    eksterniDatumKreiran  DateTime?
    eksterniDatumAzuriran DateTime?

    // Greške pri importu
    greske Json? // JSON sa greškama za svako polje

    // Napredak učenika po nastavnim godinama
    napredak Json? // JSON: { [nastavnaGodinaId]: { razred: string, pohvaleIPriznanja: string[], sufaraLekcije: string[], skolaHifzaNapredak: { [suraName]: number[] } | null } }

    // Porodični podaci
    imaRoditelje        String? // "Oba", "Majke", "Oca", itd.
    roditeljiZajedno    String? // "Da", "Ne"
    roditeljiRazdvojeni String? // "Da", "Ne"
    roditeljiClanoviIz  String? // "Majke", "Oca", itd.
    brojBrace           Int?    @default(0)
    brojSestara         Int?    @default(0)

    // Stambeni objekat
    tipStambenogObjekta String? // "Stan", "Kuća", "Podstanar"

    // Posebne potrebe
    imaPosebnePotrebe  Boolean @default(false)
    posebnePotrebeOpis String?

    // Džemat
    idPunktaDzemata Int?

    // Dodatni podaci
    clanMrezeMladih  String?
    ucenikSkoleHifza String?

    // Relacije
    korisnik                Korisnik?              @relation(fields: [korisnikId], references: [id], onDelete: Cascade)
    obrazovanje             Obrazovanje?
    roditelji               Roditelj[]
    kontakti                Kontakt[]
    grupe                   UcenikGrupa[]
    razrediNastavneGodine   RazredNastavnaGodina[]
    casPrisustvos           CasPrisustvo[]
    casOcjenas              CasOcjena[]
    skolaHifzaUcenici       SkolaHifzaUcenik[]
    skolaHifzaMuallimi      SkolaHifzaMuallim[]
    skolaHifzaPrisustva     SkolaHifzaPrisustvo[]
    skolaHifzaUcenikMuallim SkolaHifzaUcenik[]     @relation("SkolaHifzaUcenikMuallim")

    @@map("ucenici")
}

enum Spol {
    MUSKO
    ZENSKO
}

enum StatusUcenika {
    AKTIVAN
    ARHIVIRAN
}

// ============================================
// OBRAZOVANJE - PODACI O OBRAZOVANJU
// ============================================

model Obrazovanje {
    id       String @id @default(uuid())
    ucenikId String @unique

    // Nivo obrazovanja
    nivoObrazovanja String? // "Osnovna škola", "Srednja škola"
    razred          Int?
    mektebStepen    String?

    // Škole
    predskolskaNaziv String?
    osnovnaNaziv     String?
    srednjaNaziv     String?
    fakultetNaziv    String?

    kreiran  DateTime @default(now())
    azuriran DateTime @updatedAt

    // Relacije
    ucenik Ucenik @relation(fields: [ucenikId], references: [id], onDelete: Cascade)

    @@map("obrazovanje")
}

// ============================================
// RODITELJI - PODACI O RODITELJIMA
// ============================================

model Roditelj {
    id             String       @id @default(uuid())
    ucenikId       String
    tip            TipRoditelja
    imePrezime     String
    datumRodjenja  DateTime?
    mjestoRodjenja String?
    email          String?
    mobitel        String?
    telefon        String?
    zaposlen       Boolean?     @default(false)
    obrazovanje    String? // "VSS - VII stepen", "SSS - IV stepen", itd.
    zanimanje      String?
    kreiran        DateTime     @default(now())
    azuriran       DateTime     @updatedAt

    // Relacije
    ucenik Ucenik @relation(fields: [ucenikId], references: [id], onDelete: Cascade)

    @@map("roditelji")
}

enum TipRoditelja {
    MAJKA
    OTAC
}

// ============================================
// KONTAKTI (Telefoni, Email)
// ============================================

model Kontakt {
    id         String      @id @default(uuid())
    ucenikId   String
    tip        TipKontakta
    vrijednost String
    primarni   Boolean     @default(false)
    kreiran    DateTime    @default(now())
    azuriran   DateTime    @updatedAt

    // Relacije
    ucenik Ucenik @relation(fields: [ucenikId], references: [id], onDelete: Cascade)

    @@map("kontakti")
}

enum TipKontakta {
    TELEFON
    MOBITEL
    EMAIL
}

// ============================================
// IMPORTS - PRAĆENJE CSV IMPORTA
// ============================================

model Import {
    id               String        @id @default(uuid())
    nazivFajla       String
    status           StatusImporta @default(U_TOKU)
    ukupnoRedova     Int           @default(0)
    uspjesnoSacuvano Int           @default(0)
    novih            Int           @default(0)
    updateanih       Int           @default(0)
    gresaka          Int           @default(0)
    logovi           Json? // JSON sa detaljnim logovima
    kreiran          DateTime      @default(now())
    azuriran         DateTime      @updatedAt

    @@map("imports")
}

enum StatusImporta {
    U_TOKU
    USPJESAN
    NEUSPJESAN
    DJELOMICNO_USPJESAN
}

// ============================================
// RAZREDI
// ============================================

enum Ilmihal {
    ILMIHAL_I   @map("ILMIHAL I")
    ILMIHAL_II  @map("ILMIHAL II")
    ILMIHAL_III @map("ILMIHAL III")
    SKOLA_HIFZA @map("ŠKOLA HIFZA")
}

model Razred {
    id      String  @id @default(uuid())
    name    String  @unique
    ilmihal Ilmihal
    status  Boolean @default(true)

    lekcije               RazredLekcija[]
    nastavniPlanovi       NastavniPlanRazred[]
    razrediNastavneGodine RazredNastavnaGodina[]

    @@map("razredi")
}

enum TipLekcije {
    ILMIHAL
    KURAN
    SUFARA
    SKOLA_HIFZA
}

model Lekcija {
    id         String     @id @default(uuid())
    naslov     String
    opis       String
    tezina     Int
    redoslijed Int
    aktivan    Boolean    @default(true)
    tip        TipLekcije
    brojAjeta  Int? // Broj ajeta u suri (za SKOLA_HIFZA tip)
    kreiran    DateTime   @default(now())
    azuriran   DateTime   @updatedAt

    razredi          RazredLekcija[]
    nastavnihPlanova NastavniPlanRazredLekcija[]
    casLekcijas      CasLekcija[]
    casOcjenas       CasOcjena[]

    @@map("lekcije")
}

model RazredLekcija {
    id        String @id @default(uuid())
    razredId  String
    lekcijaId String

    razred  Razred  @relation(fields: [razredId], references: [id], onDelete: Cascade)
    lekcija Lekcija @relation(fields: [lekcijaId], references: [id], onDelete: Cascade)

    @@unique([razredId, lekcijaId])
    @@map("razred_lekcije")
}

// ============================================
// NASTAVNI PLANOVI
// ============================================

model NastavniPlan {
    id             String   @id @default(uuid())
    naziv          String
    opis           String
    datumUsvajanja DateTime
    aktivan        Boolean  @default(true)
    kreiran        DateTime @default(now())
    azuriran       DateTime @updatedAt

    razredi        NastavniPlanRazred[]
    nastavneGodine NastavnaGodina[]

    @@map("nastavni_planovi")
}

model NastavniPlanRazred {
    id             String @id @default(uuid())
    nastavniPlanId String
    razredId       String

    nastavniPlan NastavniPlan                @relation(fields: [nastavniPlanId], references: [id], onDelete: Cascade)
    razred       Razred                      @relation(fields: [razredId], references: [id], onDelete: Cascade)
    lekcije      NastavniPlanRazredLekcija[]

    @@unique([nastavniPlanId, razredId])
    @@map("nastavni_plan_razredi")
}

model NastavniPlanRazredLekcija {
    id                   String @id @default(uuid())
    nastavniPlanRazredId String
    lekcijaId            String

    nastavniPlanRazred NastavniPlanRazred @relation(fields: [nastavniPlanRazredId], references: [id], onDelete: Cascade)
    lekcija            Lekcija            @relation(fields: [lekcijaId], references: [id], onDelete: Cascade)

    @@unique([nastavniPlanRazredId, lekcijaId])
    @@map("nastavni_plan_razred_lekcije")
}

// ============================================
// NASTAVNA GODINA
// ============================================

enum StatusNastavneGodine {
    ACTIVE
    INACTIVE
    ARCHIVED
}

enum DanUNedelji {
    subota
    nedjelja
}

model NastavnaGodina {
    id             String               @id @default(uuid())
    naziv          String
    opis           String?
    datumOd        DateTime
    datumDo        DateTime
    nastavniPlanId String
    status         StatusNastavneGodine @default(ACTIVE)
    kreiran        DateTime             @default(now())
    azuriran       DateTime             @updatedAt

    // Relacije
    nastavniPlan NastavniPlan           @relation(fields: [nastavniPlanId], references: [id], onDelete: Restrict)
    razredi      RazredNastavnaGodina[]
    cas          Cas[]
    skolaHifza   SkolaHifza?
    slobodniDani SlobodanDan[]

    @@map("nastavne_godine")
}

model RazredNastavnaGodina {
    id               String   @id @default(uuid())
    nastavnaGodinaId String
    razredId         String
    muallimId        String // FK na Ucenik
    split            Boolean  @default(false) // Da li je razred podijeljen u grupe
    kreiran          DateTime @default(now())
    azuriran         DateTime @updatedAt

    // Relacije
    nastavnaGodina NastavnaGodina @relation(fields: [nastavnaGodinaId], references: [id], onDelete: Cascade)
    razred         Razred         @relation(fields: [razredId], references: [id], onDelete: Restrict)
    muallim        Ucenik         @relation(fields: [muallimId], references: [id], onDelete: Restrict)
    grupe          Grupa[]
    cas            Cas[]

    // Constraint: jedan razred može biti samo jednom u jednoj nastavnoj godini u istom trenutku
    @@unique([nastavnaGodinaId, razredId])
    @@map("razred_nastavna_godina")
}

model Grupa {
    id                     String   @id @default(uuid())
    razredNastavnaGodinaId String
    naziv                  String // "A" ili "B"
    kuran                  Boolean  @default(false)
    sufara                 Boolean  @default(false)
    kreiran                DateTime @default(now())
    azuriran               DateTime @updatedAt

    // Relacije
    razredNastavnaGodina RazredNastavnaGodina @relation(fields: [razredNastavnaGodinaId], references: [id], onDelete: Cascade)
    raspored             Raspored?
    ucenici              UcenikGrupa[]
    cas                  Cas[]

    @@unique([razredNastavnaGodinaId, naziv])
    @@map("grupe")
}

model Raspored {
    id       String      @id @default(uuid())
    grupaId  String      @unique
    dan      DanUNedelji
    slot     String // Format: "HH:mm" (npr. "09:10")
    lokacija String?
    trajanje Int         @default(45) // u minutama
    kreiran  DateTime    @default(now())
    azuriran DateTime    @updatedAt

    // Relacije
    grupa            Grupa           @relation(fields: [grupaId], references: [id], onDelete: Cascade)
    casovi           Cas[]
    skolaHifzaCasovi SkolaHifzaCas[]

    @@map("rasporedi")
}

model UcenikGrupa {
    id       String   @id @default(uuid())
    ucenikId String
    grupaId  String
    kreiran  DateTime @default(now())
    azuriran DateTime @updatedAt

    // Relacije
    ucenik Ucenik @relation(fields: [ucenikId], references: [id], onDelete: Cascade)
    grupa  Grupa  @relation(fields: [grupaId], references: [id], onDelete: Cascade)

    // Constraint: jedan učenik može biti samo u jednoj grupi unutar jedne nastavne godine
    @@unique([ucenikId, grupaId])
    @@map("ucenik_grupa")
}

// ============================================
// ČASOVI, PRISUSTVO I OCJENE
// ============================================

enum TipCasa {
    LEKCIJA
    PROVJERA
    POSEBNO
    PONAVLJANJE
}

enum StatusPrisustva {
    PRISUTAN
    OPRAVDAN
    NEOPRAVDAN
}

model Cas {
    id                     String    @id @default(uuid())
    nastavnaGodinaId       String
    razredNastavnaGodinaId String
    grupaId                String
    rasporedId             String
    datum                  DateTime
    tipovi                 TipCasa[]
    napomena               String?
    kreiran                DateTime  @default(now())
    azuriran               DateTime  @updatedAt

    // Relacije
    nastavnaGodina       NastavnaGodina       @relation(fields: [nastavnaGodinaId], references: [id], onDelete: Restrict)
    razredNastavnaGodina RazredNastavnaGodina @relation(fields: [razredNastavnaGodinaId], references: [id], onDelete: Restrict)
    grupa                Grupa                @relation(fields: [grupaId], references: [id], onDelete: Restrict)
    raspored             Raspored             @relation(fields: [rasporedId], references: [id], onDelete: Restrict)

    lekcije   CasLekcija[]
    prisustva CasPrisustvo[]
    ocjene    CasOcjena[]

    @@map("casovi")
}

model CasLekcija {
    id        String @id @default(uuid())
    casId     String
    lekcijaId String

    cas     Cas     @relation(fields: [casId], references: [id], onDelete: Cascade)
    lekcija Lekcija @relation(fields: [lekcijaId], references: [id], onDelete: Restrict)

    @@unique([casId, lekcijaId])
    @@map("cas_lekcije")
}

model CasPrisustvo {
    id       String          @id @default(uuid())
    casId    String
    ucenikId String
    status   StatusPrisustva
    napomena String?
    kreiran  DateTime        @default(now())
    azuriran DateTime        @updatedAt

    cas    Cas    @relation(fields: [casId], references: [id], onDelete: Cascade)
    ucenik Ucenik @relation(fields: [ucenikId], references: [id], onDelete: Restrict)

    @@unique([casId, ucenikId])
    @@map("cas_prisustva")
}

model CasOcjena {
    id        String   @id @default(uuid())
    casId     String
    ucenikId  String
    lekcijaId String
    ocjena    Int
    komentar  String?
    vrijeme   DateTime @default(now())

    cas     Cas     @relation(fields: [casId], references: [id], onDelete: Cascade)
    ucenik  Ucenik  @relation(fields: [ucenikId], references: [id], onDelete: Restrict)
    lekcija Lekcija @relation(fields: [lekcijaId], references: [id], onDelete: Restrict)

    @@unique([casId, ucenikId, lekcijaId])
    @@map("cas_ocjene")
}

// ============================================
// ŠKOLA HIFZA
// ============================================

model SkolaHifza {
    id               String   @id @default(uuid())
    nastavnaGodinaId String   @unique
    lekcije          Json? // Array of lekcija IDs: ["id1", "id2", ...]
    kreiran          DateTime @default(now())
    azuriran         DateTime @updatedAt

    // Relacije
    nastavnaGodina NastavnaGodina      @relation(fields: [nastavnaGodinaId], references: [id], onDelete: Cascade)
    muallimi       SkolaHifzaMuallim[]
    ucenici        SkolaHifzaUcenik[]
    casovi         SkolaHifzaCas[]

    @@map("skola_hifza")
}

model SkolaHifzaMuallim {
    id           String   @id @default(uuid())
    skolaHifzaId String
    muallimId    String // FK na Ucenik (muallim)
    kreiran      DateTime @default(now())
    azuriran     DateTime @updatedAt

    // Relacije
    skolaHifza SkolaHifza @relation(fields: [skolaHifzaId], references: [id], onDelete: Cascade)
    muallim    Ucenik     @relation(fields: [muallimId], references: [id], onDelete: Restrict)

    @@unique([skolaHifzaId, muallimId])
    @@map("skola_hifza_muallimi")
}

model SkolaHifzaUcenik {
    id           String   @id @default(uuid())
    skolaHifzaId String
    ucenikId     String
    muallimId    String // FK na Ucenik (muallim koji prati ovog učenika)
    napredak     Json? // Format: {"Al-Fatiha": [1,3,4], "Al-Baqara": [1,2,3,...]}
    kreiran      DateTime @default(now())
    azuriran     DateTime @updatedAt

    // Relacije
    skolaHifza SkolaHifza @relation(fields: [skolaHifzaId], references: [id], onDelete: Cascade)
    ucenik     Ucenik     @relation(fields: [ucenikId], references: [id], onDelete: Restrict)
    muallim    Ucenik     @relation("SkolaHifzaUcenikMuallim", fields: [muallimId], references: [id], onDelete: Restrict)

    @@unique([skolaHifzaId, ucenikId])
    @@map("skola_hifza_ucenici")
}

model SkolaHifzaCas {
    id           String   @id @default(uuid())
    skolaHifzaId String
    slotId       String // ID iz regularnog Raspored tabele
    datum        DateTime
    napomena     String?
    napredak     Json? // JSON sa ažuriranim napretkom za ovaj čas (kombinovani - sve ajeta koje su naučene)
    komentari    Json? // JSON sa komentarima po učeniku i suri: { "studentId": { "suraName": "komentar" } }
    kreiran      DateTime @default(now())
    azuriran     DateTime @updatedAt

    // Relacije
    skolaHifza SkolaHifza            @relation(fields: [skolaHifzaId], references: [id], onDelete: Cascade)
    slot       Raspored              @relation(fields: [slotId], references: [id], onDelete: Restrict)
    prisustva  SkolaHifzaPrisustvo[]

    @@map("skola_hifza_casovi")
}

model SkolaHifzaPrisustvo {
    id       String          @id @default(uuid())
    casId    String
    ucenikId String
    status   StatusPrisustva
    napomena String?
    kreiran  DateTime        @default(now())
    azuriran DateTime        @updatedAt

    // Relacije
    cas    SkolaHifzaCas @relation(fields: [casId], references: [id], onDelete: Cascade)
    ucenik Ucenik        @relation(fields: [ucenikId], references: [id], onDelete: Restrict)

    @@unique([casId, ucenikId])
    @@map("skola_hifza_prisustva")
}

// ============================================
// SLOBODNI DANI
// ============================================

model SlobodanDan {
    id               String   @id @default(uuid())
    nastavnaGodinaId String
    datum            DateTime // Date only (bez vremena)
    razlog           String
    kreiran          DateTime @default(now())
    azuriran         DateTime @updatedAt

    // Relacije
    nastavnaGodina NastavnaGodina @relation(fields: [nastavnaGodinaId], references: [id], onDelete: Cascade)

    @@unique([nastavnaGodinaId, datum])
    @@map("slobodni_dani")
}
