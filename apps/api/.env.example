# BACKEND (NestJS) - kopiraj u apps/api/.env
#   cp apps/api/.env.example apps/api/.env

# Baza. Lokalni Postgres iz docker-compose:
DATABASE_URL="postgresql://postgres:postgres@localhost:5439/emekteb?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5439/emekteb?schema=public"

# Supabase (Project Settings -> Database -> Connection string):
#   DATABASE_URL = Transaction pooler, port 6543 (+ ?pgbouncer=true&connection_limit=1)
#   DIRECT_URL   = Direct connection / Session pooler, port 5432 (koristi se za migracije)
# DATABASE_URL="postgresql://postgres.<ref>:<pass>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<ref>:<pass>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

NODE_ENV=development
PORT=3000

# Dozvoljeni frontend origini (odvojeni zapetom, podržan wildcard: *.vercel.app)
FRONTEND_URL=http://localhost:5173

# Obavezno u produkciji
JWT_SECRET=dev-secret-change-me

# Admin račun se kreira automatski ako baza nema nijednog admina
ADMIN_EMAIL=admin@emekteb.ba
ADMIN_PASSWORD=password123
ADMIN_PIN=0000

# "false" onemogućava truncate baze iz admin panela
ALLOW_DB_TRUNCATE=true
# Maksimalna veličina CSV fajla za import (MB)
MAX_CSV_SIZE_MB=20
